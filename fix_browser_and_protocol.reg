Windows Registry Editor Version 5.00

; 1. Google Chrome beallitasa rendszer browserkent
[HKEY_CURRENT_USER\Software\Classes\http\shell\open\command]
@="\"C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe\" --single-argument \"%1\""

[HKEY_CURRENT_USER\Software\Classes\https\shell\open\command]
@="\"C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe\" --single-argument \"%1\""

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\http\shell\open\command]
@="\"C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe\" --single-argument \"%1\""

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\https\shell\open\command]
@="\"C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe\" --single-argument \"%1\""

; 2. Antigravity URL Protokoll tarsitasa a Sandboxhoz
[HKEY_CURRENT_USER\Software\Classes\antigravity]
@="URL:antigravity"
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Classes\antigravity\shell]

[HKEY_CURRENT_USER\Software\Classes\antigravity\shell\open]

[HKEY_CURRENT_USER\Software\Classes\antigravity\shell\open\command]
@="\"C:\\Users\\WDAGUtilityAccount\\Desktop\\AstronWorkshop\\antigravity_app\\Antigravity.exe\" \"%1\""

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\antigravity]
@="URL:antigravity"
"URL Protocol"=""

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\antigravity\shell]

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\antigravity\shell\open]

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\antigravity\shell\open\command]
@="\"C:\\Users\\WDAGUtilityAccount\\Desktop\\AstronWorkshop\\antigravity_app\\Antigravity.exe\" \"%1\""
